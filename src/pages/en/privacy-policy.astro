---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import siteContent from '../../content/site.en.json';

const lang = 'en';
---

<MainLayout
  title={`Website Privacy Policy | ${siteContent.company}`}
  description="Website Privacy Policy for Agentic Governance — how this site handles cookies, analytics, and your browsing data."
  lang={lang}
>
  <Header lang={lang} content={siteContent} />

  <main>
    <section class="bg-gradient-to-br from-secondary-900 to-secondary-800 py-16">
      <div class="container-custom">
        <div class="mx-auto max-w-4xl text-center">
          <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Website Privacy Policy</h1>
          <p class="text-xl text-secondary-300">
            How this website handles cookies, analytics, and your data.
          </p>
        </div>
      </div>
    </section>

    <section class="section-padding">
      <div class="container-custom">
        <div class="mx-auto max-w-4xl">
          <div class="mb-8 p-6 rounded-xl bg-primary-50 dark:bg-primary-900/20 border border-primary-200 dark:border-primary-800">
            <p class="text-sm text-secondary-600 dark:text-secondary-400">
              <strong class="text-secondary-900 dark:text-white">Last Updated:</strong> November 23, 2026<br />
              <strong class="text-secondary-900 dark:text-white">Version fran&ccedil;aise :</strong> <a href="/fr/politique-de-confidentialite" class="text-primary-600 dark:text-primary-400 hover:underline">Politique de confidentialit&eacute;</a>
            </p>
          </div>

          <div class="prose prose-lg dark:prose-invert max-w-none">
            <h2 class="mt-8 text-2xl font-bold text-secondary-900 dark:text-white">The short version</h2>
            <p class="text-secondary-700 dark:text-secondary-300">
              This is a static informational website. It has no accounts, no contact forms, and no advertising trackers. The only data collected is privacy-respecting web analytics and standard server logs.
            </p>

            <h2 class="mt-8 text-2xl font-bold text-secondary-900 dark:text-white">Analytics</h2>
            <p class="text-secondary-700 dark:text-secondary-300">
              This site uses Google Analytics (GA4) to understand aggregate traffic patterns — pages viewed, approximate geography, device type. Analytics cookies are only set after you accept them through the consent banner (provided by Termly). You can change your choice at any time via the "Consent Preferences" link in the footer.
            </p>

            <h2 class="mt-8 text-2xl font-bold text-secondary-900 dark:text-white">Local storage</h2>
            <p class="text-secondary-700 dark:text-secondary-300">
              Your theme (light/dark) and language preferences are stored in your browser's localStorage. This data never leaves your device.
            </p>

            <h2 class="mt-8 text-2xl font-bold text-secondary-900 dark:text-white">Server logs</h2>
            <p class="text-secondary-700 dark:text-secondary-300">
              The site is served via Google Cloud Run behind a Google load balancer. Standard infrastructure logs (IP address, user agent, timestamps) are retained temporarily by Google Cloud for operations and security.
            </p>

            <h2 class="mt-8 text-2xl font-bold text-secondary-900 dark:text-white">Email</h2>
            <p class="text-secondary-700 dark:text-secondary-300">
              If you email <a href="mailto:info@datasciencetech.ca" class="text-primary-600 dark:text-primary-400 hover:underline">info@datasciencetech.ca</a>, your message and address are used solely to respond to you. They are not added to any mailing list or shared with third parties.
            </p>

            <h2 class="mt-8 text-2xl font-bold text-secondary-900 dark:text-white">Your rights</h2>
            <p class="text-secondary-700 dark:text-secondary-300">
              You may request access to, correction of, or deletion of any personal data held about you by writing to <a href="mailto:info@datasciencetech.ca" class="text-primary-600 dark:text-primary-400 hover:underline">info@datasciencetech.ca</a>.
            </p>

            <p class="mt-8 text-secondary-500 dark:text-secondary-500 text-sm">
              &copy; 2026 Agentic Governance
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} content={siteContent} />
</MainLayout>
