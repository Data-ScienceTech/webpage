---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import siteContent from '../../content/site.en.json';
import content from '../../content/legal.en.json';

const lang = 'en';

const iconPaths: Record<string, string> = {
  shield: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  document: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  check: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4',
};

const tagColors: Record<string, string> = {
  Privacy: 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300',
  Terms: 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300',
  Policy: 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300',
  Security: 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300',
};
---

<MainLayout
  title={content.meta.title}
  description={content.meta.description}
  lang={lang}
>
  <Header lang={lang} content={siteContent} />

  <main>
    <!-- Hero -->
    <section class="bg-gradient-to-br from-secondary-900 via-secondary-800 to-primary-900 py-16">
      <div class="container-custom">
        <div class="mx-auto max-w-3xl text-center">
          <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-primary-500/20 px-4 py-1.5 text-sm font-semibold text-primary-300">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
            </svg>
            {content.hero.badge}
          </div>
          <h1 class="mb-4 text-4xl font-bold tracking-tight text-white md:text-5xl">
            {content.hero.title}
          </h1>
          <p class="text-lg text-secondary-300">
            {content.hero.subtitle}
          </p>
        </div>
      </div>
    </section>

    <!-- Document Categories -->
    <section class="section-padding">
      <div class="container-custom">
        <div class="mx-auto max-w-5xl space-y-14">
          {content.categories.map((category) => (
            <div>
              <div class="mb-6 flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600 text-white">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[category.icon]} />
                  </svg>
                </div>
                <h2 class="text-2xl font-bold text-secondary-900 dark:text-white">{category.title}</h2>
              </div>
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {category.documents.map((doc) => (
                  <a
                    href={doc.href}
                    class="group relative flex flex-col rounded-xl border border-secondary-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:border-primary-300 hover:shadow-md dark:border-secondary-700 dark:bg-secondary-800 dark:hover:border-primary-600"
                  >
                    <div class="mb-3 flex items-start justify-between gap-2">
                      <h3 class="text-base font-semibold text-secondary-900 group-hover:text-primary-600 dark:text-white dark:group-hover:text-primary-400">
                        {doc.title}
                      </h3>
                      <span class={`shrink-0 rounded-full px-2 py-0.5 text-xs font-medium ${tagColors[doc.tag] ?? 'bg-secondary-100 text-secondary-600 dark:bg-secondary-700 dark:text-secondary-300'}`}>
                        {doc.tag}
                      </span>
                    </div>
                    <p class="mb-4 flex-1 text-sm text-secondary-600 dark:text-secondary-400">
                      {doc.description}
                    </p>
                    <span class="inline-flex items-center gap-1 text-sm font-medium text-primary-600 dark:text-primary-400">
                      Read document
                      <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>

        <!-- Entity info -->
        <div class="mx-auto mt-16 max-w-5xl rounded-xl border border-secondary-200 bg-secondary-50 p-6 dark:border-secondary-700 dark:bg-secondary-800/50">
          <div class="flex flex-wrap items-center gap-6 text-sm text-secondary-600 dark:text-secondary-400">
            <div>
              <span class="font-semibold text-secondary-900 dark:text-white">{content.entity.label}:</span>{' '}
              {content.entity.name}
            </div>
            <div>
              <span class="font-semibold text-secondary-900 dark:text-white">{content.entity.contact_label}:</span>{' '}
              <a href={`mailto:${content.entity.contact}`} class="text-primary-600 hover:underline dark:text-primary-400">
                {content.entity.contact}
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} content={siteContent} />
</MainLayout>
