---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

import siteContent from '../../content/site.en.json';
import content from '../../content/jetbrains-plugin.en.json';

const lang = 'en';
---

<MainLayout
  title={content.meta.title}
  description={content.meta.description}
  lang={lang}
>
  <Header lang={lang} content={siteContent} />

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden bg-gradient-to-br from-secondary-900 via-secondary-800 to-primary-900 pt-12 pb-10 md:pt-16 md:pb-12">
      <div class="absolute inset-0 opacity-5">
        <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px]" viewBox="0 0 200 200" fill="none">
          <rect x="40" y="40" width="120" height="120" rx="12" stroke="currentColor" stroke-width="1" class="text-primary-400"/>
          <path d="M70 100 L90 120 L130 80" stroke="currentColor" stroke-width="3" class="text-primary-400" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
      </div>
      <div class="container-custom relative">
        <div class="mx-auto max-w-4xl text-center">
          <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-primary-500/20 px-4 py-1.5 text-sm font-semibold text-primary-300">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            JetBrains Marketplace
          </div>
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white tracking-tight mb-4">
            {content.hero.title}
          </h1>
          <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-primary-400">{content.hero.subtitle}</p>
          <p class="text-lg md:text-xl text-secondary-300 mb-4 max-w-2xl mx-auto">
            {content.hero.tagline}
          </p>
          <div class="flex flex-wrap items-center justify-center gap-2 mb-6">
            {content.hero.badges.map((badge: string) => (
              <span class="inline-flex items-center rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-primary-200 border border-white/20">{badge}</span>
            ))}
          </div>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href={content.cta.marketplace_url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-accent inline-flex items-center gap-2 text-base px-6 py-3"
            >
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              {content.cta.marketplace}
            </a>
            <a
              href={content.cta.sdk_url}
              class="inline-flex items-center gap-2 text-sm text-secondary-300 hover:text-white transition-colors"
            >
              {content.cta.sdk} &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="py-10 bg-gradient-to-r from-primary-600 to-primary-700 dark:from-primary-700 dark:to-primary-800">
      <div class="container-custom">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-4xl mx-auto text-center">
          {content.stats.map((stat) => (
            <div>
              <p class="text-3xl md:text-4xl font-bold text-white mb-1">{stat.value}</p>
              <p class="text-sm text-primary-100 uppercase tracking-wide font-medium">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="section-padding bg-white dark:bg-secondary-800">
      <div class="container-custom">
        <div class="mx-auto max-w-5xl">
          <h2 class="mb-3 text-3xl md:text-4xl font-bold text-secondary-900 dark:text-white text-center">{content.features.title}</h2>
          <p class="mb-10 text-lg text-primary-600 dark:text-primary-400 font-semibold text-center">{content.features.subtitle}</p>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {content.features.items.map((feature) => (
              <div class="rounded-2xl border border-secondary-200 dark:border-secondary-700 bg-secondary-50 dark:bg-secondary-900 p-6">
                <h3 class="text-lg font-bold text-secondary-900 dark:text-white mb-2">{feature.title}</h3>
                <p class="text-sm text-secondary-600 dark:text-secondary-300">{feature.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- What It Detects -->
    <section class="section-padding bg-secondary-50 dark:bg-secondary-900">
      <div class="container-custom">
        <h2 class="mb-10 text-3xl md:text-4xl font-bold text-secondary-900 dark:text-white text-center">{content.detection.title}</h2>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 max-w-5xl mx-auto">
          {content.detection.categories.map((cat) => (
            <div class="rounded-xl border border-secondary-200 dark:border-secondary-700 bg-white dark:bg-secondary-800 p-5">
              <h3 class="text-base font-bold text-secondary-900 dark:text-white mb-2">{cat.name}</h3>
              <p class="text-sm text-secondary-600 dark:text-secondary-300">{cat.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="section-padding bg-white dark:bg-secondary-800">
      <div class="container-custom">
        <div class="mx-auto max-w-3xl">
          <h2 class="mb-8 text-3xl md:text-4xl font-bold text-secondary-900 dark:text-white text-center">{content.how_it_works.title}</h2>
          <div class="space-y-3">
            {content.how_it_works.items.map((item: string) => (
              <div class="flex items-start gap-3">
                <svg class="mt-1 h-5 w-5 text-primary-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4" />
                </svg>
                <p class="text-secondary-700 dark:text-secondary-300">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Get Started -->
    <section class="section-padding bg-secondary-50 dark:bg-secondary-900">
      <div class="container-custom">
        <h2 class="mb-10 text-3xl md:text-4xl font-bold text-secondary-900 dark:text-white text-center">{content.setup.title}</h2>
        <div class="grid gap-6 md:grid-cols-3 max-w-4xl mx-auto">
          {content.setup.steps.map((step) => (
            <div class="rounded-2xl border-2 border-secondary-200 dark:border-secondary-700 bg-white dark:bg-secondary-800 p-6 text-center">
              <div class="mx-auto mb-4 h-10 w-10 rounded-full bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                <span class="text-lg font-bold text-primary-600 dark:text-primary-400">{step.number}</span>
              </div>
              <h3 class="text-base font-bold text-secondary-900 dark:text-white mb-2">{step.title}</h3>
              {step.code && (
                <code class="text-sm bg-secondary-100 dark:bg-secondary-700 text-secondary-800 dark:text-secondary-200 px-3 py-1.5 rounded block font-mono">{step.code}</code>
              )}
              {step.description && (
                <p class="text-sm text-secondary-600 dark:text-secondary-300">{step.description}</p>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Compatible IDEs -->
    <section class="section-padding bg-white dark:bg-secondary-800">
      <div class="container-custom">
        <div class="mx-auto max-w-3xl text-center">
          <h2 class="mb-4 text-3xl md:text-4xl font-bold text-secondary-900 dark:text-white">{content.compatible_ides.title}</h2>
          <p class="mb-8 text-secondary-600 dark:text-secondary-300">{content.compatible_ides.description}</p>
          <div class="flex flex-wrap items-center justify-center gap-3">
            {content.compatible_ides.ides.map((ide: string) => (
              <span class="inline-flex items-center rounded-full bg-primary-50 dark:bg-primary-900/20 border border-primary-200 dark:border-primary-800 px-4 py-1.5 text-sm font-medium text-primary-700 dark:text-primary-300">
                {ide}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Also Available -->
    <section class="py-10 bg-gradient-to-r from-primary-600 to-primary-700 dark:from-primary-700 dark:to-primary-800">
      <div class="container-custom">
        <h3 class="text-xl font-bold text-white text-center mb-6">{content.also_available.title}</h3>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          {content.also_available.links.map((link) => (
            <a
              href={link.url}
              class="inline-flex flex-col items-center rounded-xl bg-white/10 border border-white/20 px-6 py-4 text-white hover:bg-white/20 transition-colors text-center min-w-[160px]"
            >
              <span class="font-semibold text-sm">{link.label}</span>
              <span class="text-xs text-primary-200 mt-1">{link.description}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section-padding bg-white dark:bg-secondary-800">
      <div class="container-custom text-center">
        <h2 class="mb-6 text-3xl md:text-4xl font-bold text-secondary-900 dark:text-white">Get Started</h2>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={content.cta.marketplace_url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-accent inline-flex items-center gap-2 px-6 py-3"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            {content.cta.marketplace}
          </a>
          <a
            href={content.cta.gateway_url}
            class="btn inline-flex items-center gap-2 border-2 border-secondary-300 dark:border-secondary-600 text-secondary-700 dark:text-secondary-300 hover:bg-secondary-100 dark:hover:bg-secondary-700 px-6 py-3"
          >
            {content.cta.gateway} &rarr;
          </a>
        </div>
        <p class="mt-4 text-sm text-secondary-500 dark:text-secondary-400">
          <a href={content.cta.sdk_url} class="text-primary-600 dark:text-primary-400 hover:underline">{content.cta.sdk}</a>
          &nbsp;&middot;&nbsp;
          <a href={content.cta.vscode_url} class="text-primary-600 dark:text-primary-400 hover:underline">{content.cta.vscode}</a>
        </p>
      </div>
    </section>
  </main>

  <Footer lang={lang} content={siteContent} />
</MainLayout>
