---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

import siteContent from '../../content/site.en.json';

const lang = 'en';
const pageTitle = siteContent.meta.title;
---

<MainLayout
  title={pageTitle}
  description={siteContent.meta.description}
  lang={lang}
>
  <Header lang={lang} content={siteContent} />

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden py-12 md:py-16 bg-gradient-to-br from-secondary-900 via-secondary-800 to-primary-900">
      <div class="absolute inset-0 opacity-5">
        <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px]" viewBox="0 0 560 340" fill="none">
          <path d="M26 92 L156 58 L156 86 L66 108 L66 232 L156 254 L156 282 L26 248 Z" stroke="currentColor" stroke-width="4" class="text-primary-400"/>
          <path d="M534 92 L404 58 L404 86 L494 108 L494 232 L404 254 L404 282 L534 248 Z" stroke="currentColor" stroke-width="4" class="text-primary-400"/>
          <path d="M280 124 L326 170 L280 216 L234 170 Z" stroke="currentColor" stroke-width="4" class="text-primary-400"/>
        </svg>
      </div>
      <div class="container-custom relative">
        <div class="mx-auto max-w-4xl text-center">
          <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-primary-400">{siteContent.hero.eyebrow}</p>
          <h1 class="mb-6 text-4xl md:text-5xl font-bold text-white tracking-tight leading-tight">
            {siteContent.hero.title}
          </h1>
          <p class="mb-10 text-lg md:text-xl text-secondary-300 max-w-3xl mx-auto">
            {siteContent.hero.subtitle}
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href={siteContent.services.items[0].href}
              class="btn-accent inline-flex items-center gap-2 text-lg px-8 py-4"
            >
              {siteContent.hero.cta_primary}
            </a>
            <a
              href={siteContent.services.items[1].href}
              class="btn inline-flex items-center gap-2 border-2 border-white/30 text-white hover:bg-white/10 text-lg px-8 py-4"
            >
              {siteContent.hero.cta_secondary}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section class="section-padding bg-white dark:bg-secondary-800">
      <div class="container-custom">
        <div class="mx-auto max-w-4xl text-center mb-12">
          <h2 class="mb-3 text-3xl md:text-4xl font-bold text-secondary-900 dark:text-white">{siteContent.services.title}</h2>
          <p class="text-lg text-secondary-500 dark:text-secondary-400">{siteContent.services.subtitle}</p>
        </div>
        <div class="grid gap-8 md:grid-cols-2 max-w-5xl mx-auto">
          {siteContent.services.items.map((service: any) => (
            <div class="flex flex-col rounded-2xl border border-secondary-200 dark:border-secondary-700 bg-secondary-50 dark:bg-secondary-900 p-6">
              <h3 class="text-xl font-bold text-secondary-900 dark:text-white mb-2">{service.name}</h3>
              <p class="text-sm text-secondary-600 dark:text-secondary-400 mb-4">{service.description}</p>
              <ul class="space-y-2 flex-1">
                {service.points.map((point: string) => (
                  <li class="flex items-start gap-2 text-sm text-secondary-600 dark:text-secondary-300">
                    <svg class="mt-0.5 h-4 w-4 text-primary-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {point}
                  </li>
                ))}
              </ul>
              <a href={service.href} class="btn-primary mt-6 text-sm text-center !py-3">{service.cta}</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- What you receive -->
    <section class="py-12 bg-secondary-50 dark:bg-secondary-900">
      <div class="container-custom">
        <h2 class="mb-8 text-2xl md:text-3xl font-bold text-secondary-900 dark:text-white text-center">{siteContent.receive.title}</h2>
        <div class="grid gap-8 md:grid-cols-2 max-w-4xl mx-auto">
          {siteContent.receive.items.map((item: any) => (
            <div class="rounded-xl border border-secondary-200 dark:border-secondary-700 bg-white dark:bg-secondary-800 p-5">
              <h3 class="text-sm font-bold uppercase tracking-wide text-primary-600 dark:text-primary-400">{item.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-secondary-600 dark:text-secondary-300">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Open ForceField -->
    <section class="section-padding bg-white dark:bg-secondary-800">
      <div class="container-custom">
        <div class="mx-auto max-w-4xl">
          <div class="text-center mb-10">
            <span class="inline-flex items-center rounded-full bg-primary-100 dark:bg-primary-900/40 border border-primary-300 dark:border-primary-700 px-4 py-1.5 text-sm font-semibold text-primary-700 dark:text-primary-300 mb-4">
              {siteContent.open_forcefield.badge}
            </span>
            <h2 class="mb-4 text-3xl md:text-4xl font-bold text-secondary-900 dark:text-white">{siteContent.open_forcefield.title}</h2>
            <p class="text-lg text-secondary-500 dark:text-secondary-400 max-w-2xl mx-auto">
              {siteContent.open_forcefield.description}
            </p>
          </div>
          <div class="grid gap-8 md:grid-cols-2 items-start">
            <div class="rounded-2xl border border-secondary-200 dark:border-secondary-700 bg-secondary-50 dark:bg-secondary-900 p-6">
              <ul class="space-y-3">
                {siteContent.open_forcefield.points.map((point: string) => (
                  <li class="flex items-start gap-3 text-sm text-secondary-700 dark:text-secondary-300">
                    <svg class="mt-0.5 h-4 w-4 text-primary-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {point}
                  </li>
                ))}
              </ul>
            </div>
            <div class="space-y-6">
              <div class="bg-secondary-900 dark:bg-secondary-950 border border-secondary-700 rounded-xl px-6 py-4 font-mono text-primary-300 text-lg select-all text-center">
                $ {siteContent.open_forcefield.install}
              </div>
              <div class="grid grid-cols-2 gap-3">
                <a href={siteContent.open_forcefield.links.page} class="btn-primary text-sm text-center !py-3">{siteContent.open_forcefield.cta_page}</a>
                <a href={siteContent.open_forcefield.links.github} target="_blank" rel="noopener" class="btn-secondary text-sm text-center !py-3">{siteContent.open_forcefield.cta_github}</a>
                <a href={siteContent.open_forcefield.links.pypi} target="_blank" rel="noopener" class="btn-secondary text-sm text-center !py-3">{siteContent.open_forcefield.cta_pypi}</a>
                <a href={siteContent.open_forcefield.links.demo} target="_blank" rel="noopener" class="btn-secondary text-sm text-center !py-3">{siteContent.open_forcefield.cta_demo}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- About -->
    <section class="section-padding bg-secondary-50 dark:bg-secondary-900">
      <div class="container-custom">
        <div class="mx-auto max-w-3xl">
          <h2 class="mb-6 text-3xl md:text-4xl font-bold text-secondary-900 dark:text-white text-center">{siteContent.about.title}</h2>
          {siteContent.about.paragraphs.map((p: string) => (
            <p class="mb-4 text-lg text-secondary-600 dark:text-secondary-300">{p}</p>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="section-padding bg-white dark:bg-secondary-800">
      <div class="container-custom text-center">
        <h2 class="mb-4 text-3xl md:text-4xl font-bold text-secondary-900 dark:text-white">{siteContent.contact.title}</h2>
        <p class="mb-6 text-lg text-secondary-500 dark:text-secondary-400 max-w-xl mx-auto">
          {siteContent.contact.subtitle}
        </p>
        <a href={`mailto:${siteContent.contact.email}`} class="btn-accent inline-flex items-center gap-2 px-8 py-4 text-lg">
          {siteContent.contact.cta} — {siteContent.contact.email}
        </a>
      </div>
    </section>
  </main>

  <Footer lang={lang} content={siteContent} />
</MainLayout>
