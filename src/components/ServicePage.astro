---
interface Props {
  lang: 'en' | 'fr';
  content: any;
}

const { lang, content } = Astro.props;
const mailto = `mailto:info@datasciencetech.ca?subject=${encodeURIComponent(content.cta.subject)}`;
---

<!-- Hero -->
<section class="border-b border-secondary-200 bg-gradient-to-b from-primary-50 to-white py-16 dark:border-secondary-700 dark:from-secondary-800 dark:to-secondary-900 md:py-20">
  <div class="container-custom max-w-4xl">
    <p class="text-sm font-semibold uppercase tracking-wider text-primary-600 dark:text-primary-400">{content.eyebrow}</p>
    <h1 class="mt-3 font-headline text-3xl font-bold text-secondary-900 dark:text-white md:text-4xl">{content.title}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-secondary-600 dark:text-secondary-300">{content.intro}</p>
  </div>
</section>

<!-- Triggers + Method -->
<section class="py-14 md:py-16">
  <div class="container-custom grid max-w-5xl gap-12 md:grid-cols-2">
    <div>
      <h2 class="font-headline text-xl font-bold text-secondary-900 dark:text-white">{content.triggers.heading}</h2>
      <ul class="mt-5 space-y-4">
        {content.triggers.items.map((item: string) => (
          <li class="flex gap-3 text-secondary-600 dark:text-secondary-300">
            <svg class="mt-1 h-5 w-5 shrink-0 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="font-headline text-xl font-bold text-secondary-900 dark:text-white">{content.method.heading}</h2>
      <p class="mt-5 text-secondary-600 dark:text-secondary-300">{content.method.intro}</p>
      <ol class="mt-5 space-y-3">
        {content.method.steps.map((step: string, i: number) => (
          <li class="flex gap-3 text-secondary-600 dark:text-secondary-300">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary-100 text-xs font-bold text-primary-700 dark:bg-primary-900 dark:text-primary-300">{i + 1}</span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<!-- Illustrative example -->
<section class="border-y border-secondary-200 bg-secondary-50 py-14 dark:border-secondary-700 dark:bg-secondary-800/50 md:py-16">
  <div class="container-custom max-w-4xl">
    <div class="flex flex-wrap items-baseline gap-3">
      <h2 class="font-headline text-xl font-bold text-secondary-900 dark:text-white">{content.example.heading}</h2>
      <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">{content.example.label}</span>
    </div>
    <div class="mt-6 space-y-5 rounded-xl border border-secondary-200 bg-white p-6 dark:border-secondary-700 dark:bg-secondary-800 md:p-8">
      {content.example.fields.map((field: { label: string; text: string }) => (
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wide text-primary-600 dark:text-primary-400">{field.label}</h3>
          <p class="mt-1.5 leading-relaxed text-secondary-600 dark:text-secondary-300">{field.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Deliverables + what you provide -->
<section class="py-14 md:py-16">
  <div class="container-custom grid max-w-5xl gap-12 md:grid-cols-2">
    <div>
      <h2 class="font-headline text-xl font-bold text-secondary-900 dark:text-white">{content.deliverables.heading}</h2>
      <ul class="mt-5 space-y-4">
        {content.deliverables.items.map((item: string) => (
          <li class="flex gap-3 text-secondary-600 dark:text-secondary-300">
            <svg class="mt-1 h-5 w-5 shrink-0 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="font-headline text-xl font-bold text-secondary-900 dark:text-white">{content.provides.heading}</h2>
      <ul class="mt-5 space-y-4">
        {content.provides.items.map((item: string) => (
          <li class="flex gap-3 text-secondary-600 dark:text-secondary-300">
            <svg class="mt-1 h-5 w-5 shrink-0 text-secondary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

{content.proof && (
  <section class="border-t border-secondary-200 py-12 dark:border-secondary-700">
    <div class="container-custom max-w-4xl">
      <h2 class="font-headline text-xl font-bold text-secondary-900 dark:text-white">{content.proof.heading}</h2>
      <p class="mt-3 leading-relaxed text-secondary-600 dark:text-secondary-300">{content.proof.text}</p>
      <a href={`/${lang}/open-forcefield`} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-600 transition hover:text-primary-700 dark:text-primary-400">
        {content.proof.link}
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </a>
    </div>
  </section>
)}

<!-- CTA -->
<section class="border-t border-secondary-200 bg-gradient-to-b from-white to-primary-50 py-14 dark:border-secondary-700 dark:from-secondary-900 dark:to-secondary-800 md:py-16">
  <div class="container-custom max-w-2xl text-center">
    <h2 class="font-headline text-2xl font-bold text-secondary-900 dark:text-white">{content.cta.heading}</h2>
    <p class="mt-3 text-secondary-600 dark:text-secondary-300">{content.cta.text}</p>
    <a href={mailto} class="btn-primary mt-7 inline-flex items-center">{content.cta.button}</a>
    <p class="mt-4 text-sm text-secondary-500 dark:text-secondary-400">info@datasciencetech.ca</p>
  </div>
</section>
