---
import LangSwitch from './LangSwitch';
import { alternates } from '../i18n/routes';

interface Props {
  lang: 'en' | 'fr';
  content: any;
}

const { lang, content } = Astro.props;
const alt = alternates(Astro.url.pathname) ?? { en: '/en/', fr: '/fr/' };
const currentYear = new Date().getFullYear();
const L = content.footer.links;

const projectLinks = [
  { href: `/${lang}/open-forcefield`, label: L.project },
  { href: content.open_forcefield.links.github, label: L.github, external: true },
  { href: content.open_forcefield.links.pypi, label: L.pypi, external: true },
  { href: `/${lang}/benchmarks`, label: L.benchmarks },
  { href: lang === 'en' ? '/en/vscode-extension' : '/fr/extension-vscode', label: L.vscode },
  { href: lang === 'en' ? '/en/jetbrains-plugin' : '/fr/plugin-jetbrains', label: L.jetbrains },
  { href: content.open_forcefield.links.demo, label: L.demo, external: true },
];

const siteLinks = [
  { href: lang === 'en' ? '/en/privacy-policy' : '/fr/politique-de-confidentialite', label: L.privacy },
  { href: lang === 'en' ? '/en/responsible-disclosure' : '/fr/divulgation-responsable', label: L.disclosure },
];
---

<footer class="border-t border-secondary-200 bg-secondary-50 dark:border-secondary-700 dark:bg-secondary-800">
  <div class="container-custom section-padding">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <img src="/logo.svg" alt={content.company} class="mb-4 h-12 w-auto md:h-14 dark:hidden" />
        <img src="/logo-dark.svg" alt={content.company} class="mb-4 hidden h-12 w-auto md:h-14 dark:block" />
        <p class="mb-4 text-secondary-600 dark:text-secondary-400">
          {content.footer.description}
        </p>
        {content.footer.tagline && (
          <p class="mb-2 text-sm font-medium text-primary-600 dark:text-primary-400 italic">
            {content.footer.tagline}
          </p>
        )}
        {content.footer.languages && (
          <p class="mb-4 text-sm text-secondary-500 dark:text-secondary-500">
            {content.footer.languages}
          </p>
        )}
        <div class="flex space-x-4">
          <a
            href={content.social.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="text-secondary-600 transition-colors hover:text-primary-600 dark:text-secondary-400 dark:hover:text-primary-400"
          >
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <a
            href={content.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="text-secondary-600 transition-colors hover:text-primary-600 dark:text-secondary-400 dark:hover:text-primary-400"
          >
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Open ForceField Links -->
      <div>
        <h3 class="mb-4 text-lg font-semibold text-secondary-900 dark:text-white">
          {L.projectHeading}
        </h3>
        <ul class="space-y-2">
          {projectLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="footer-link"
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Site & Legal -->
      <div>
        <h3 class="mb-4 text-lg font-semibold text-secondary-900 dark:text-white">
          {L.legalHeading}
        </h3>
        <ul class="space-y-2">
          {siteLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link">{link.label}</a>
            </li>
          ))}
          <li>
            <button type="button" class="termly-display-preferences footer-link">{L.consent}</button>
          </li>
          <li>
            <a href={`mailto:${content.contact.email}`} class="footer-link">{content.contact.email}</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 flex flex-col items-center justify-between border-t border-secondary-200 pt-8 dark:border-secondary-700 md:flex-row">
      <p class="text-sm text-secondary-500 dark:text-secondary-400">
        {content.footer.copyright}
      </p>
      <div class="mt-4 md:mt-0">
        <LangSwitch lang={lang} enHref={alt.en} frHref={alt.fr} client:load />
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    @apply text-secondary-600 transition-colors hover:text-primary-600 dark:text-secondary-400 dark:hover:text-primary-400;
  }
</style>
